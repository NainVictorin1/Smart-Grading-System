<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Grade Management System</title>
    <link rel="stylesheet" href="/static/style.css">
    <style>
        /* Style for logout button in the header */
        .logout-button {
            position: absolute;
            top: 10px;
            right: 10px;
        }

        .logout-button form {
            display: inline;
        }

        .logout-button button {
            background-color: #f44336;
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
        }

        .logout-button button:hover {
            background-color: #d32f2f;
        }
    </style>
</head>
<body>
<header>
    <h1>Smart Grading System</h1>
    <nav>
        <div>
            <a href="/">Home</a>
        </div>
    </nav>

    <!-- Logout button in the top-right corner -->
    {{ if .IsAuthenticated }}
    <div class="logout-button">
        <form action="/user/logout" method="POST">
            <input type="hidden" name="csrf_token" value="{{ .CSRFToken }}">
            <button type="submit">Logout</button>
        </form>
    </div>
    {{ end }}
</header>

<div class="home-container">
    <div class="wrapper">
        <header>
            <h1>Welcome to the Smart Grade Management System</h1>
        </header>
        <nav>
            <ul>
                <li><a href="/grade">View Grades</a></li>
                <li><a href="/create_grade">Create Grade</a></li>
            </ul>
        </nav>
        <footer>
            <p>Advance Database Test 1 - 2025 | Smart Grade Management By Nain Victorin</p>
        </footer>
    </div>
</div>
</body>
</html>