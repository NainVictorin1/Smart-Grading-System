<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/static/style.css">
    <title>{{.Title}}</title>

</head>
<body>
<div class="list-grades-container">
    <h1>{{.HeaderText}}</h1>
    {{if .SuccessMessage}}
    <p style="color: green; text-align: center;">{{.SuccessMessage}}</p>
    {{end}}
    <table>
        <thead>
            <tr>
                <th>Student</th>
                <th>Subject</th>
                <th>Email</th>
                <th>Grade</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {{range .Grades}}
            <tr>
                <td>{{.Fullname}}</td>
                <td>{{.Subject}}</td>
                <td>{{.Email}}</td>
                <td>{{.Grade}}</td>
                <td>
                    <a href="/grades/edit?id={{.ID}}">Edit</a> | 
                    <a href="/grades/delete?id={{.ID}}">Delete</a>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="4" style="text-align: center; color: #888;">No grades available</td>
            </tr>
            {{end}}
        </tbody>
    </table>
    
</div>
<div class="action-buttons" style="text-align: center;">
    <a href="/create_grade">Create Grade</a>
    <a href="/">Back to Home</a>
</div>
    
</body>
</html>